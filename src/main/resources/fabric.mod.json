{
	"schemaVersion": 1,
	"id": "moonpet",
	"version": "${version}",
	"name": "MoonPet",
	"description": "An AI-powered pet companion for Minecraft that follows chat commands and helps in the world.",
	"authors": [
		"Starry-field"
	],
	"contact": {
		"homepage": "https://github.com/Starry-field/MoonPet",
		"sources": "https://github.com/Starry-field/MoonPet"
	},
	"license": "CC0-1.0",
	"icon": "assets/moonpet/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.starrymoon.moonpet.MoonPet"
		],
		"client": [
			"io.github.starrymoon.moonpet.client.MoonPetClient"
		]
	},
	"mixins": [
		"moonpet.mixins.json",
		{
			"config": "moonpet.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.4",
		"java": ">=21",
		"fabric-api": "*"
	}
}
